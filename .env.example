# ---------------------------------------------------------------------------
# Tienda - environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# Public app identity
NEXT_PUBLIC_APP_NAME=Tienda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Root domain used to resolve store subdomains (e.g. store.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (preferred by the browser/server clients)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy anon JWT, used as a fallback when the publishable key is not set
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets. Never expose these to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (use the Supavisor pooler host, port 5432, session mode)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Payments: mock | wompi | mercadopago
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------------------
# Later phases (leave commented until the feature is enabled)
# ---------------------------------------------------------------------------
# Wompi public key used by the browser checkout widget
# WOMPI_PUBLIC_KEY=
# Wompi private key used server-side to create/verify transactions
# WOMPI_PRIVATE_KEY=
# Wompi secret used to verify webhook event signatures
# WOMPI_EVENTS_SECRET=
# Wompi secret used to sign the checkout integrity hash
# WOMPI_INTEGRITY_SECRET=
# Mercado Pago server access token for creating preferences and reading payments
# MERCADOPAGO_ACCESS_TOKEN=
# Resend API key for transactional email (order confirmations, receipts)
# RESEND_API_KEY=
# Web Push VAPID public key exposed to the browser for push subscriptions
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Web Push VAPID private key used server-side to sign push messages
# VAPID_PRIVATE_KEY=
# Contact address advertised to the push service, must start with mailto:
# VAPID_SUBJECT=mailto:you@example.com
# OpenRouteService API key (only needed when ROUTING_PROVIDER=ors)
# ORS_API_KEY=
# Routing engine for courier ETAs/distances: osrm (public demo server) | ors
# ROUTING_PROVIDER=osrm

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Sentry DSN. Leave empty and the app runs unchanged with logging only.
# SENTRY_DSN=
# Label attached to Sentry events; falls back to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=
